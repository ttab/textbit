{
  "name": "@ttab/textbit",
  "version": "1.7.0-beta.3",
  "license": "MIT",
  "description": "Textbit is an editable component created as part of the Elephant project, based on Slate.",
  "author": {
    "name": "Danne Lundqvist"
  },
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "build:types": "tsc -p tsconfig.lib.json --noEmit false",
    "lint": "eslint . --cache --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ttab/textbit"
  },
  "peerDependencies": {
    "@slate-yjs/core": "^1.0.2",
    "@slate-yjs/react": "^1.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "slate": "^0.126.2",
    "slate-react": "^0.126.4",
    "yjs": "^13.6.26"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@slate-yjs/core": "^1.0.2",
    "@slate-yjs/react": "^1.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/is-hotkey": "^0.1.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "slate": "^0.126.2",
    "slate-react": "^0.126.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11",
    "yjs": "^13.6.26"
  },
  "dependencies": {
    "is-hotkey": "^0.2.0",
    "slate-history": "^0.113.1",
    "y-protocols": "^1.0.5"
  }
}
