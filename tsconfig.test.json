{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "vite/client",
      "vitest",
      "@testing-library/jest-dom"
    ],
    // Mirrors the '@' alias in vitest.config.ts
    "paths": {
      "@/*": ["./lib/*"]
    }
  },
  "include": [
    "__tests__"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
